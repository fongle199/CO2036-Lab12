A = 3;
f = 50;
Fs = 300;
Ts = 1/Fs;
Delta = 0.1;
t = linspace(0, 0.1, 1000);
xa = 3*sin(100*%pi*t);
n = 0:29;
xn = 3*sin(%pi*n/3);
xq = Delta * sign(xn) .* floor(abs(xn)/Delta);
clf();
subplot(3,1,1);
plot(t, xa);
xtitle("Analog signal xa(t) = 3sin(100*pi*t)", "t (s)", "xa(t)");
xgrid();
subplot(3,1,2);
plot2d3(n, xn);
xtitle("Discrete-time signal x(n)", "n", "x(n)");
xgrid();
subplot(3,1,3);
plot2d3(n, xq);
xtitle("Quantized signal xq(n), Delta = 0.1", "n", "xq(n)");
xgrid();
